# Oak custom codecs

# OakCodec5: Default codec for new indexes (Lucene 5.x), delegates to Lucene54Codec
org.apache.jackrabbit.oak.plugins.index.lucene.OakCodec5

# OakCodec: Backward compatibility codec for reading indexes created with Lucene 4.x
# Uses Lucene46Codec with Lucene40-46 formats to read old "oakCodec" indexes
org.apache.jackrabbit.oak.plugins.index.lucene.OakCodec

# CompressingCodec: High compression codec for smaller index size
org.apache.jackrabbit.oak.plugins.index.lucene.util.CompressingCodec

# Note: Additional backward compatibility codecs (Lucene40-46, Lucene50, Lucene53) are provided
# by the lucene-backward-codecs module and registered via its own SPI file.
# These allow reading indexes created with older Lucene versions.
